{
    "compilerOptions": {
        "plugins": [],
        "checkJs": false,
        "skipLibCheck": true,
        "target": "ES2022",
        "resolveJsonModule": true,
        "lib": [
            "ES2022"
        ],
        "module": "commonjs",
        "paths": {
            "@package": [
                "../../../.probe/@package"
            ],
            "@package/*": [
                "../../../.probe/@package/*"
            ],
            "@side-only/startup": [
                "../../../.probe/@side-only/startup"
            ],
            "@side-only/startup/*": [
                "../../../.probe/@side-only/startup/*"
            ],
            "@special": [
                "../../../.probe/@special"
            ],
            "@special/*": [
                "../../../.probe/@special/*"
            ]
        }
    },
    "typeAcquisition": {
        "enable": false
    },
    "include": [
        "./**/*.js",
        "./**/*.d.ts",
        "../../../.probe/@package/**/*.d.ts",
        "../../../.probe/@side-only/startup/**/*.d.ts",
        "../../../.probe/@special/**/*.d.ts",
        "../../../global.d.ts"
    ]
}